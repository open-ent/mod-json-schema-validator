<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.tech.openent</groupId>
    <artifactId>modules</artifactId>
    <version>3.0.3-SNAPSHOT</version>
  </parent>

  <groupId>com.opendigitaleducation</groupId>
  <artifactId>mod-json-schema-validator</artifactId>
  <version>3.0.0-patched</version>

  <properties>
    <!-- Use available web-utils version (parent default 3.0.3-SNAPSHOT not cached) -->
    <web-utils.version>3.3.1</web-utils.version>
    <shade.minimizeJar>false</shade.minimizeJar>
    <!-- json-schema-validator 3.0.2 requires Java 17 + rewrites entirely new API -->
    <!-- (no JsonSchema/JsonSchemaFactory/SpecVersion/ValidationMessage in 3.0.2) -->
    <jsonSchemaValidatorVersion>1.0.87</jsonSchemaValidatorVersion>
    <junitVersion>4.13.2</junitVersion>
  </properties>

  <scm>
    <connection>scm:git:https://github.com/opendigitaleducation/mod-json-schema-validator.git</connection>
    <developerConnection>scm:git:https://github.com/opendigitaleducation/mod-json-schema-validator.git</developerConnection>
    <url>https://github.com/opendigitaleducation/mod-json-schema-validator</url>
  </scm>

  <repositories>
    <repository>
      <id>ode</id>
      <name>ODE Repository</name>
      <url>https://maven.opendigitaleducation.com/nexus/content/groups/public</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>fr.wseduc</groupId>
      <artifactId>web-utils</artifactId>
      <version>${web-utils.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${jsonSchemaValidatorVersion}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junitVersion}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <!-- Override shade output to use groupId~artifactId~version-fat format for launcher -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade</id>
            <configuration>
              <outputFile/>
              <finalName>${project.groupId}~${project.artifactId}~${project.version}-fat</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
